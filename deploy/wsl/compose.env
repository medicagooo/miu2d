# AI-TRACE: mirrored WSL cannot expose native-Docker iptables DNAT directly to Windows.
# Compose keeps nginx private on 18080; miu2d-web-proxy.socket owns Windows-visible 8080.
WEB_HOST_PORT=18080

# AI-TRACE: local PostgreSQL intentionally has no copyrighted demo rows. The WSL web
# image proxies only demo/sword1/sword2 public API and resource reads to production.
REMOTE_DEMOS=true
