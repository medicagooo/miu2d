# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=miu2d_db

# MinIO (S3 兼容文件存储)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_BUCKET=miu2d
S3_REGION=us-east-1

# Docker Web 主机端口；普通部署保持 8080，WSL mirrored 由 deploy/wsl/compose.env 覆盖。
WEB_HOST_PORT=8080
# 仅允许已知的公开演示 slug 读取远程 API/资源；普通本地部署默认关闭。
REMOTE_DEMOS=false

# AI-TRACE: Docker server 通过内部 http://minio:9000 访问对象存储；浏览器通过
# Nginx 的 /s3 代理访问签名 URL。这里的公网端点、APP_URL、CORS 和 Cookie
# 共同定义同源访问契约，修改端口或域名时必须同步调整。
S3_PUBLIC_ENDPOINT=http://localhost:8080/s3
APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
SESSION_COOKIE_SECURE=false

# 资源域名配置（可选）
# 配置后资源将从此域名加载，如: https://cdn.example.com/game/xxx/resources/...
# 未配置则从当前域名加载: /game/[gameSlug]/resources/...
# VITE_DEMO_RESOURCES_DOMAIN=https://your-r2-domain.example.com

# 邮件 SMTP（重置密码 / 邮箱验证）
# QQ 邮箱域名邮箱：SMTP_HOST=smtp.qq.com，端口 465（SSL）
# SMTP_PASS 为授权码（非登录密码），生产环境请写入服务器本地 .env，勿提交仓库
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-auth-code
SMTP_FROM=Miu2D Engine <your@email.com>
# 生产 SMTP 启用时，邮件链接使用上面的 APP_URL。
