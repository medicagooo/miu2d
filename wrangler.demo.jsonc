{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miu2d",
  "main": "packages/server/src/worker-demo.ts",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/site-region", "/cloud-save/*", "/trpc", "/trpc/*", "/game/*", "/s3", "/s3/*"]
  },
  "d1_databases": [{ "binding": "CLOUD_DB" }],
  "r2_buckets": [{ "binding": "CLOUD_SAVES" }],
  "ratelimits": [
    { "name": "CLOUD_AUTH_LIMIT", "namespace_id": "913001", "simple": { "limit": 10, "period": 60 } },
    { "name": "CLOUD_WRITE_LIMIT", "namespace_id": "913002", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
