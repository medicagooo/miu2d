{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miu2d",
  "main": "packages/server/dist-worker/worker.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/health/*", "/site-region", "/trpc", "/trpc/*", "/game/*", "/s3/*"]
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
  "images": { "binding": "IMAGES" },
  "durable_objects": { "bindings": [{ "name": "AUTH_RATE_LIMIT", "class_name": "AuthRateLimit" }] },
  "migrations": [{ "tag": "auth-rate-limit-v1", "new_sqlite_classes": ["AuthRateLimit"] }],
  "vars": { "NODE_ENV": "production", "SESSION_COOKIE_SECURE": "true" },
  "secrets": { "required": ["S3_ENDPOINT", "MINIO_ROOT_USER", "MINIO_ROOT_PASSWORD", "MINIO_BUCKET", "S3_PUBLIC_ENDPOINT", "APP_URL", "CORS_ORIGINS"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
