# ======================================
# Server 环境变量 (本地开发)
# ======================================

# 数据库连接 URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5533/miu2d_db

# AI-TRACE: 这些名称由 src/env.ts 直接读取，并被 storage/s3.ts 同时用于服务端
# 对象操作和预签名 URL；本地开发端口对应根目录 docker-compose.yml 的映射。
# MinIO (S3 兼容文件存储)
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_BUCKET=miu2d
S3_PUBLIC_ENDPOINT=http://localhost:9100

# SMTP 邮件发送配置
# 不配置则跳过邮件发送（日志中会有警告）
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=Miu2D Engine <noreply@example.com>

# 前端 URL（用于邮件中的链接）
APP_URL=http://localhost:5274
CORS_ORIGINS=http://localhost:5274
SESSION_COOKIE_SECURE=false

PORT=4100
